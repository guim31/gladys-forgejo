{
  "manifest_version": 1,
  "type": "device",
  "name": "Forgejo / Gitea",
  "description": {
    "en": "Your Forgejo, Gitea or Codeberg repositories in Gladys: releases, issues, CI status.",
    "fr": "Vos dépôts Forgejo, Gitea ou Codeberg dans Gladys : versions, tickets, état de la CI.",
    "de": "Deine Forgejo-, Gitea- oder Codeberg-Repositorys in Gladys: Releases, Issues, CI-Status.",
    "es": "Sus repositorios de Forgejo, Gitea o Codeberg en Gladys: versiones, incidencias, estado de la CI."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-forgejo:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-forgejo/main/cover.png",
  "categories": ["services"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your forge",
        "fr": "Votre forge",
        "de": "Deine Forge",
        "es": "Su forja"
      },
      "description": {
        "en": "Enter the address of your Forgejo or Gitea, or codeberg.org. A token is needed for private repositories only: create it in Settings → Applications with the read:repository and read:issue permissions. Then list the repositories to follow.",
        "fr": "Saisissez l'adresse de votre Forgejo ou Gitea, ou codeberg.org. Un jeton n'est utile que pour les dépôts privés : créez-le dans Configuration → Applications avec les droits read:repository et read:issue. Listez ensuite les dépôts à suivre.",
        "de": "Gib die Adresse deines Forgejo oder Gitea ein, oder codeberg.org. Ein Token brauchst du nur für private Repositorys: Erstelle es unter Einstellungen → Anwendungen mit den Rechten read:repository und read:issue. Liste dann die zu verfolgenden Repositorys auf.",
        "es": "Introduzca la dirección de su Forgejo o Gitea, o codeberg.org. Solo necesita un token para los repositorios privados: créelo en Configuración → Aplicaciones con los permisos read:repository y read:issue. Después indique los repositorios que desea seguir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-forgejo/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://forgejo.org/docs/latest/user/api-usage/",
          "label": {
            "en": "Forgejo API tokens",
            "fr": "Jetons d'API Forgejo",
            "de": "Forgejo-API-Tokens",
            "es": "Tokens de API de Forgejo"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Forge address",
        "fr": "Adresse de la forge",
        "de": "Adresse der Forge",
        "es": "Dirección de la forja"
      },
      "description": {
        "en": "The address you open the forge with: http://192.168.1.2:3000, https://git.example.com or codeberg.org.",
        "fr": "L'adresse avec laquelle vous ouvrez la forge : http://192.168.1.2:3000, https://git.example.com ou codeberg.org.",
        "de": "Die Adresse, mit der du die Forge öffnest: http://192.168.1.2:3000, https://git.example.com oder codeberg.org.",
        "es": "La dirección con la que abre la forja: http://192.168.1.2:3000, https://git.example.com o codeberg.org."
      },
      "placeholder": {
        "en": "e.g. codeberg.org",
        "fr": "ex. codeberg.org",
        "de": "z. B. codeberg.org",
        "es": "p. ej. codeberg.org"
      },
      "required": false
    },
    {
      "key": "token",
      "type": "secret",
      "label": {
        "en": "Access token (optional)",
        "fr": "Jeton d'accès (facultatif)",
        "de": "Zugriffstoken (optional)",
        "es": "Token de acceso (opcional)"
      },
      "description": {
        "en": "Read-only is enough (read:repository, read:issue). Empty: public repositories only.",
        "fr": "La lecture seule suffit (read:repository, read:issue). Vide : dépôts publics seulement.",
        "de": "Nur-Lesen reicht (read:repository, read:issue). Leer: nur öffentliche Repositorys.",
        "es": "Basta con solo lectura (read:repository, read:issue). Vacío: solo repositorios públicos."
      },
      "required": false
    },
    {
      "key": "repositories",
      "type": "string",
      "label": {
        "en": "Repositories to follow",
        "fr": "Dépôts à suivre",
        "de": "Zu verfolgende Repositorys",
        "es": "Repositorios que seguir"
      },
      "description": {
        "en": "owner/name or links copied from the browser, separated by commas. 20 at most.",
        "fr": "propriétaire/nom ou liens copiés du navigateur, séparés par des virgules. 20 au plus.",
        "de": "Besitzer/Name oder aus dem Browser kopierte Links, durch Kommas getrennt. Höchstens 20.",
        "es": "propietario/nombre o enlaces copiados del navegador, separados por comas. 20 como máximo."
      },
      "placeholder": {
        "en": "e.g. forgejo/forgejo, me/my-app",
        "fr": "ex. forgejo/forgejo, moi/mon-app",
        "de": "z. B. forgejo/forgejo, ich/meine-app",
        "es": "p. ej. forgejo/forgejo, yo/mi-app"
      },
      "required": false
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle d'actualisation",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often the repositories are read: five requests per repository each time.",
        "fr": "La fréquence de lecture des dépôts : cinq requêtes par dépôt à chaque fois.",
        "de": "Wie oft die Repositorys gelesen werden: jedes Mal fünf Anfragen pro Repository.",
        "es": "Con qué frecuencia se leen los repositorios: cinco solicitudes por repositorio cada vez."
      },
      "required": false,
      "default": "10",
      "options": [
        {
          "value": "5",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 hour",
            "fr": "1 heure",
            "de": "1 Stunde",
            "es": "1 hora"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (set when a device is added), of the CI statuses and of the scene texts.",
        "fr": "Langue des noms des fonctionnalités (fixés à l'ajout d'un appareil), des états de CI et des textes de scène.",
        "de": "Sprache der Funktionsnamen (beim Hinzufügen eines Geräts festgelegt), der CI-Status und der Szenentexte.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir un dispositivo), de los estados de CI y de los textos de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 120
    }
  ],
  "scene_triggers": [
    {
      "key": "release_published",
      "label": {
        "en": "New release published",
        "fr": "Nouvelle version publiée",
        "de": "Neues Release veröffentlicht",
        "es": "Nueva versión publicada"
      },
      "description": {
        "en": "A release or a pre-release of a followed repository is out.",
        "fr": "Une version ou une préversion d'un dépôt suivi est sortie.",
        "de": "Ein Release oder Pre-Release eines verfolgten Repositorys ist erschienen.",
        "es": "Ha salido una versión o una versión preliminar de un repositorio seguido."
      },
      "fields": [
        {
          "key": "repository",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Repository",
            "fr": "Dépôt",
            "de": "Repository",
            "es": "Repositorio"
          }
        },
        {
          "key": "release_type",
          "type": "select",
          "label": {
            "en": "Type",
            "fr": "Type",
            "de": "Typ",
            "es": "Tipo"
          },
          "options": [
            {
              "value": "stable",
              "label": {
                "en": "Release",
                "fr": "Version",
                "de": "Release",
                "es": "Versión"
              }
            },
            {
              "value": "prerelease",
              "label": {
                "en": "Pre-release",
                "fr": "Préversion",
                "de": "Pre-Release",
                "es": "Versión preliminar"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "repository_name",
          "type": "string",
          "label": {
            "en": "Repository (owner/name)",
            "fr": "Dépôt (propriétaire/nom)",
            "de": "Repository (Besitzer/Name)",
            "es": "Repositorio (propietario/nombre)"
          }
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Release name",
            "fr": "Nom de la version",
            "de": "Name des Release",
            "es": "Nombre de la versión"
          }
        },
        {
          "key": "tag",
          "type": "string",
          "label": {
            "en": "Tag",
            "fr": "Étiquette",
            "de": "Tag",
            "es": "Etiqueta"
          }
        },
        {
          "key": "author",
          "type": "string",
          "label": {
            "en": "Author",
            "fr": "Auteur",
            "de": "Autor",
            "es": "Autor"
          }
        },
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "Link",
            "fr": "Lien",
            "de": "Link",
            "es": "Enlace"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Summary, ready for a message",
            "fr": "Résumé, prêt pour un message",
            "de": "Zusammenfassung für eine Nachricht",
            "es": "Resumen, listo para un mensaje"
