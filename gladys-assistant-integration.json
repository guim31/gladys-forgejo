  "scene_actions": [
    {
      "key": "get_repository",
      "label": {
        "en": "Read a repository",
        "fr": "Lire un dépôt",
        "de": "Repository lesen",
        "es": "Leer un repositorio"
      },
      "description": {
        "en": "The figures of a followed repository, for the next actions of the scene.",
        "fr": "Les chiffres d'un dépôt suivi, pour les actions suivantes de la scène.",
        "de": "Die Zahlen eines verfolgten Repositorys für die nächsten Aktionen der Szene.",
        "es": "Las cifras de un repositorio seguido, para las siguientes acciones de la escena."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "repository",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Repository",
            "fr": "Dépôt",
            "de": "Repository",
            "es": "Repositorio"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "repository_name",
          "type": "string",
          "label": {
            "en": "Repository (owner/name)",
            "fr": "Dépôt (propriétaire/nom)",
